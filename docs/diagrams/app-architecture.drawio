<mxfile host="app.diagrams.net">
  <diagram name="Application Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Cloud-Native DevOps Platform - Application Architecture" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="30" width="1000" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="browser" value="👤&lt;br&gt;&lt;b&gt;User Browser&lt;/b&gt;&lt;br&gt;HTTP Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="360" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="network" value="🐳  &lt;b&gt;Docker Compose Bridge Network&lt;/b&gt;&lt;br&gt;cv-network" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=#ffffff;strokeColor=#2563eb;fontSize=15;fontColor=#1e3a8a;align=left;verticalAlign=top;spacingLeft=25;spacingTop=20;" vertex="1" parent="1">
          <mxGeometry x="390" y="230" width="820" height="560" as="geometry"/>
        </mxCell>

        <mxCell id="nginx-entry" value="&lt;b&gt;NGINX&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;fontColor=#15803d;align=center;" vertex="1" parent="1">
          <mxGeometry x="720" y="250" width="160" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="frontend" value="⚛️  &lt;b&gt;Frontend Container&lt;/b&gt;&lt;br&gt;React + Vite&lt;br&gt;Served by Nginx&lt;br&gt;&lt;font color=&quot;#15803d&quot;&gt;&lt;b&gt;Port: 3000 → 80&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="310" width="560" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="backend" value="⚡  &lt;b&gt;Backend Container&lt;/b&gt;&lt;br&gt;FastAPI + Uvicorn&lt;br&gt;Swagger UI: /docs&lt;br&gt;&lt;font color=&quot;#ea580c&quot;&gt;&lt;b&gt;Port: 8000&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontSize=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="480" width="560" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="postgres" value="🐘  &lt;b&gt;PostgreSQL Container&lt;/b&gt;&lt;br&gt;Database: app&lt;br&gt;User: app&lt;br&gt;&lt;font color=&quot;#6d28d9&quot;&gt;&lt;b&gt;Port: 5432&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;fontSize=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="650" width="560" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="env" value="📄  &lt;b&gt;Environment Configuration&lt;/b&gt;&lt;br&gt;&lt;br&gt;• backend/.env&lt;br&gt;• frontend/.env&lt;br&gt;• .env.example committed&lt;br&gt;&lt;hr&gt;Contains configuration for API URLs, database, secrets and application settings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=15;shadow=1;align=left;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="260" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="health" value="💙  &lt;b&gt;Healthchecks&lt;/b&gt;&lt;br&gt;&lt;br&gt;✅ Postgres&lt;br&gt;pg_isready&lt;br&gt;&lt;br&gt;✅ Backend&lt;br&gt;/docs endpoint&lt;br&gt;&lt;br&gt;✅ Frontend&lt;br&gt;nginx response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=15;shadow=1;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="1270" y="350" width="250" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="volume" value="🛢️  &lt;b&gt;Named Volume&lt;/b&gt;&lt;br&gt;postgres_data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;fontSize=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="690" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="stack" value="&lt;b&gt;Technology Stack&lt;/b&gt;&lt;br&gt;🐳 Docker Compose   |   ⚛️ React + Vite   |   ⚡ FastAPI   |   🟢 Nginx   |   🐘 PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="820" width="940" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="ℹ️  The application is containerized and orchestrated using Docker Compose. All services run on an isolated bridge network with healthchecks, environment-based configuration, and persistent PostgreSQL storage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;fontSize=15;fontColor=#0f172a;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="925" width="1120" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;━━ Request / Data Flow&lt;br&gt;┄┄ Configuration / Healthcheck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=14;shadow=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1320" y="830" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="browser" target="nginx-entry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0f172a;strokeWidth=2;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" edge="1" parent="1" source="nginx-entry" target="frontend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0f172a;strokeWidth=2;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" value="API Calls (HTTP)" edge="1" parent="1" source="frontend" target="backend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284c7;strokeWidth=2;endArrow=block;fontSize=14;fontStyle=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" value="SQL Connection" edge="1" parent="1" source="backend" target="postgres" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;fontSize=14;fontStyle=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e5" value="Persistent Data" edge="1" parent="1" source="postgres" target="volume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;fontSize=14;fontStyle=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" edge="1" parent="1" source="env" target="frontend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7" edge="1" parent="1" source="env" target="backend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e8" edge="1" parent="1" source="health" target="frontend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e9" edge="1" parent="1" source="health" target="backend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e10" edge="1" parent="1" source="health" target="postgres" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
