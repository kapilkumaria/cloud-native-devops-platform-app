# Application
PROJECT_NAME="Cloud Native DevOps Platform"
ENVIRONMENT=local
DOMAIN=localhost

# Security
# Replace with strong values in the local backend/.env file.
SECRET_KEY=

# PostgreSQL
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Initial administrative user
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=

# Browser origins allowed to call the backend
BACKEND_CORS_ORIGINS=http://localhost:3000

# Optional application settings
USERS_OPEN_REGISTRATION=false
